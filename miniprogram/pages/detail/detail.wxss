/* pages/detail/detail.wxss */

.book-header {
  display: flex;
  margin-bottom: 24rpx;
}

.header-cover {
  width: 200rpx;
  height: 280rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 28rpx;
  background: #f0f0f0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.header-info {
  flex: 1;
  overflow: hidden;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.3;
  margin-bottom: 4rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.header-author {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.header-meta-list {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

.header-meta-list text {
  display: inline-block;
  margin-right: 16rpx;
}

.header-rating {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 10rpx 0;
}

.header-rating .rating-star {
  color: #FF9800;
  font-size: 30rpx;
  margin-right: 6rpx;
}

.header-rating .rating-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9800;
  margin-right: 8rpx;
}

.header-rating .rating-count {
  font-size: 24rpx;
  color: #bbb;
}

.header-status {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 状态修改 */
.status-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.status-switch {
  display: flex;
  gap: 12rpx;
}

.status-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  transition: all 0.2s;
}

.status-btn.active {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-weight: 600;
}

/* 我的评分 */
.rating-section {
  margin-bottom: 24rpx;
}

.user-rating {
  display: flex;
  align-items: center;
}

.star {
  font-size: 48rpx;
  color: #ddd;
  margin-right: 8rpx;
  transition: color 0.15s;
}

.star-active {
  color: #FF9800;
}

.rating-hint {
  font-size: 26rpx;
  color: #FF9800;
  margin-left: 12rpx;
  font-weight: 600;
}

/* 短评 */
.comment-section {
  margin-bottom: 24rpx;
  position: relative;
}

.comment-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.6;
  padding: 12rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.comment-count {
  text-align: right;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 简介 */
.summary-section {
  margin-bottom: 24rpx;
}

.summary-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

/* 详细信息 */
.info-section {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  max-width: 60%;
  text-align: right;
}

.info-value.link {
  color: var(--color-primary);
}

/* 删除按钮 */
.action-section {
  padding: 24rpx 0 60rpx;
}

.delete-btn {
  width: 100%;
  background: #fff;
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  text-align: center;
}

.delete-btn:active {
  background: #fff5f5;
}

/* 加载 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #999;
  font-size: 28rpx;
}
