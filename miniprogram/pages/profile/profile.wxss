/* pages/profile/profile.wxss */

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  margin-right: 28rpx;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.user-info {
  flex: 1;
}

.nickname-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 8rpx;
  height: 50rpx;
  line-height: 50rpx;
}

.user-desc {
  font-size: 24rpx;
  color: #999;
}

/* 统计 */
.stats-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.stats-grid {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
}

.stat-item:not(:last-child) {
  border-right: 1rpx solid #f5f5f5;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.2;
}

.stat-number.wish { color: #FF9800; }
.stat-number.reading { color: #2196F3; }
.stat-number.read { color: #4CAF50; }

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 评分分布 */
.rating-dist {
  margin-bottom: 24rpx;
}

.dist-bars {
  margin-bottom: 20rpx;
}

.dist-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dist-label {
  width: 56rpx;
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.dist-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  background: linear-gradient(90deg, #FF9800, #FFC107);
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.dist-count {
  width: 56rpx;
  font-size: 24rpx;
  color: #666;
  text-align: right;
  flex-shrink: 0;
}

.avg-rating {
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.avg-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF9800;
}

/* 关于 */
.about-section {
  margin-bottom: 24rpx;
}

.about-item {
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #999;
  border-bottom: 1rpx solid #f5f5f5;
}

.about-item:last-child {
  border-bottom: none;
}
