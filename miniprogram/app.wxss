/* app.wxss - 全局样式 */
page {
  --color-primary: #2F5C3E;
  --color-primary-light: #4A8C5C;
  --color-primary-bg: #E8F5E9;
  --color-text: #333333;
  --color-text-secondary: #666666;
  --color-text-light: #999999;
  --color-border: #EEEEEE;
  --color-bg: #F5F5F5;
  --color-white: #FFFFFF;
  --color-wish: #FF9800;
  --color-reading: #2196F3;
  --color-read: #4CAF50;

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
}

/* 卡片样式 */
.card {
  background: var(--color-white);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 按钮样式 */
.btn-primary {
  background: var(--color-primary);
  color: var(--color-white);
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
}

.btn-primary:active {
  background: var(--color-primary-light);
}

.btn-outline {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 12rpx;
  padding: 18rpx 48rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  color: var(--color-text-light);
}

.empty-state .empty-text {
  font-size: 28rpx;
  color: var(--color-text-light);
  text-align: center;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-wish {
  background: #FFF3E0;
  color: var(--color-wish);
}

.tag-reading {
  background: #E3F2FD;
  color: var(--color-reading);
}

.tag-read {
  background: #E8F5E9;
  color: var(--color-read);
}

/* 文本省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
