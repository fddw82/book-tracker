/* components/book-card/book-card.wxss */
.book-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.book-card:active {
  opacity: 0.85;
}

.book-cover-wrap {
  position: relative;
  width: 140rpx;
  height: 190rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.book-cover {
  width: 100%;
  height: 100%;
}

.status-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  text-align: center;
  padding: 4rpx 0;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
}

.tag-wish {
  background: rgba(255, 152, 0, 0.8);
}

.tag-reading {
  background: rgba(33, 150, 243, 0.8);
}

.tag-read {
  background: rgba(76, 175, 80, 0.8);
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.book-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.book-author {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.book-rating {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.rating-star {
  color: #FF9800;
  font-size: 24rpx;
  margin-right: 4rpx;
}

.rating-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #FF9800;
  margin-right: 6rpx;
}

.rating-count {
  font-size: 22rpx;
  color: #bbb;
}

.book-user-rating {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.my-star {
  font-size: 22rpx;
  color: #999;
}

.star-on {
  color: #FF9800;
  font-size: 22rpx;
}

.star-off {
  color: #ddd;
  font-size: 22rpx;
}

.book-date {
  font-size: 22rpx;
  color: #bbb;
}
